---
import SectionHeading from '../components/SectionHeading.astro';
import Base from '../layouts/Base.astro';
import { getTeam } from '../lib/content';

const { supervisor, members: team } = await getTeam();
---

<Base title="Team">
  <section class="title">
    <h1>Team</h1>
  </section>

  <section>
    <SectionHeading title="Supervisor" />
    <ul class="list">
      <li class="row">
        <span class="name">{supervisor.name}</span>
        <span class="muted">{supervisor.affiliation}</span>
      </li>
    </ul>
  </section>

  <section>
    <SectionHeading title="Members" />
    <ul class="list">
      {
        team.map((p) => (
          <li class="row member">
            <span class="name">{p.name}</span>
            <span class="stack">
              <span>{p.role}</span>
              {p.area && <span class="muted area">{p.area}</span>}
            </span>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .member {
    padding: 16px 0;
  }

  .stack {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .name {
    font-weight: 500;
    white-space: nowrap;
  }

  .area {
    font-size: 15px;
    line-height: 1.55;
  }
</style>
